# =====================================================
# PAKH Precheck — Cấu hình biến môi trường
# =====================================================
# Sao chép file này thành .env rồi điền API key thật
# KHÔNG commit file .env lên GitHub!

# Groq AI API Key (lấy miễn phí tại https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Groq AI sử dụng
# Xem danh sách model tại: https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.6-27b

# =====================================================
# Tài khoản VNPT TTS (dùng cho tính năng auto-login)
# =====================================================
TTS_USER=your_username
TTS_PASS=your_password

# =====================================================
# API Key hệ thống CEM (VNPT Media)
# =====================================================
CEM_API_KEY=net_ktm_quangvu%dQpWVpQzaWTyNz5dT5Y0Dijwd0m2u6emBS1yWmZv

