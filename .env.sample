# ==============================================================================
# PAKH PRECHECK - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.sample)
# Sao chép file này thành .env trên máy chủ triển khai: cp .env.sample .env
# ==============================================================================

# Cổng truy cập Web Dashboard trên máy chủ (Mặc định: 1234)
PORT=1234

# Múi giờ hệ thống
TZ=Asia/Ho_Chi_Minh

# ==============================================================================
# CẤU HÌNH CÁC HỆ THỐNG LIÊN KẾT VNPT
# ==============================================================================

# 1. Hệ thống CEM (Customer Experience Management - Sóng trạm VNPT Media)
CEM_API_URL=https://api-cem.vnptmedia.vn/api2/getSubHistoryInfo
# CEM_API_KEY=net_ktm_quangvu%... (Tự động cập nhật qua VNPT Token Utilities từ Client)

# 2. Hệ thống BTools (Tra lịch sử gói cước & phiên dữ liệu 4G/5G)
BTOOLS_URL=http://10.159.21.241:9267/B_tools_v2/

# 3. Hệ thống Core SAPC (Tra cờ NAM khóa cước, profile APN SIM)
SAPC_BASE_URL=http://10.155.42.218/api/sapc

# 4. Hệ thống CCOS (Chăm sóc khách hàng tập trung)
CCOS_BASE_URL=https://gqknccos.vnpt.vn/

# 5. Hệ thống OneOSS / TTS Mới (Quản lý phiếu sự cố mạng lưới)
ONEOSS_BASE_URL=https://gw-oneoss.vnpt.vn/oss/tts/ticket/ticket-tts-api/Ticket

# 6. Hệ thống Bản đồ & CustomerPosition / Cell Geocoding (Port 1708)
# - Nếu container port 1708 chạy trên cùng máy chủ host: giữ nguyên http://host.docker.internal:1708
# - Nếu container port 1708 chạy ở IP hoặc hostname máy chủ khác: thay bằng http://<IP_MAY_CHU>:1708
PORT_1708_URL=http://host.docker.internal:1708

# ==============================================================================
# CẤU HÌNH AI & PHÂN TÍCH Ý ĐỊNH PHẢN ÁNH (Tùy chọn)
# ==============================================================================
# Mô hình AI Offline Qwen 2.5 (Copy file .gguf vào thư mục models/)
LOCAL_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
LOCAL_LLM_THREADS=4

# GROQ_API_KEY=gsk_...

