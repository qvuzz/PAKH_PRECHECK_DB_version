{
  "manifest_version": 3,
  "name": "VNPT Token Utilities",
  "version": "1.0.0",
  "description": "Tien ich dong bo Session, Cookie va Bearer Token tu dong cho he sinh thai cong cu ky thuat VNPT",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://*.vnpt.vn/*",
    "*://*.vnptnet.vn/*",
    "*://*.vnptmedia.vn/*",
    "*://10.159.21.241/*",
    "*://10.155.42.218/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://10.159.21.241:9267/*",
    "http://10.159.21.241:9267/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VNPT Token Utilities",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}